# PostgreSQL values used by docker-compose.yml and the FastAPI backend.
POSTGRES_DB=baymax
POSTGRES_USER=baymax
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://baymax:change-me-for-local-development@localhost:5432/baymax
BACKEND_CORS_ORIGINS=http://localhost:5173
APP_ENV=development
GEMINI_API_KEY=replace-with-a-new-key
GEMINI_MODEL=gemini-3.6-flash

# Frontend (Vite exposes only variables prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:8000/api/v1
